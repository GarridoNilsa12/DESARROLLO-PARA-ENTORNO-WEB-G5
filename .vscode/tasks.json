{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ng serve",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/angular-app" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "." },
          "endsPattern": { "regexp": "Local:|bundle generation complete" }
        }
      }
    }
  ]
}
